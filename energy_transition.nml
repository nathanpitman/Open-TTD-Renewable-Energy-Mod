item(FEAT_INDUSTRYTILES, tile_tidal_barrage,     16) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_tidal_station(0); } }
item(FEAT_INDUSTRYTILES, tile_tidal_hall,        17) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_tidal_station(1); } }
item(FEAT_INDUSTRYTILES, tile_wind_a,            18) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(0); } }
item(FEAT_INDUSTRYTILES, tile_wind_b,            19) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(1); } }
item(FEAT_INDUSTRYTILES, tile_wind_c,            20) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(2); } }
item(FEAT_INDUSTRYTILES, tile_wind_d,            21) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(3); } }
item(FEAT_INDUSTRYTILES, tile_solar_panels,      22) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_solar_farm(0); } }
item(FEAT_INDUSTRYTILES, tile_solar_inverter,    23) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_solar_farm(1); } }
item(FEAT_INDUSTRYTILES, tile_solar_control,     24) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_solar_farm(2); } }
item(FEAT_INDUSTRYTILES, tile_sub_transformers,  25) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_substation(0); } }
item(FEAT_INDUSTRYTILES, tile_sub_pylon,         26) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_substation(1); } }
item(FEAT_INDUSTRYTILES, tile_coal_boiler,       27) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_coal_power_plant(0); } }
item(FEAT_INDUSTRYTILES, tile_coal_yard,         28) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_coal_power_plant(1); } }
/* Wind farm spacing tiles: turbines never sit on adjacent tiles, so rotors don't overlap. */
item(FEAT_INDUSTRYTILES, tile_wind_track_x,      29) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(4); } }
item(FEAT_INDUSTRYTILES, tile_wind_track_y,      30) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(5); } }
item(FEAT_INDUSTRYTILES, tile_wind_kiosk,        31) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(6); } }
item(FEAT_INDUSTRYTILES, tile_wind_grass,        32) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm_grass; } }

/* ── TILE LAYOUTS ──────────────────────────────────────────────── */
/* x runs to the lower-left of the screen, y to the lower-right; 0,0 is the back (north) tile. */
tilelayout layout_uranium_mine  { 0,0: tile_uranium_headframe; 1,0: tile_uranium_mill;
                                  0,1: tile_uranium_tailings;  1,1: tile_uranium_ore; }
tilelayout layout_nuclear_plant { 0,0: tile_nuc_cooling;    0,1: tile_nuc_cooling;  0,2: tile_nuc_switchyard;
                                  1,0: tile_nuc_turbine2;   1,1: tile_nuc_reactor;  1,2: tile_nuc_turbine;
                                  2,0: tile_nuc_intake;     2,1: tile_nuc_admin;    2,2: tile_nuc_tanks; }
/* Hydro dam: the wall tiles sit on the water side, the power house on the other. */
tilelayout layout_hydro_dam     { 0,0: tile_hydro_dam_n;       0,1: tile_hydro_dam_s;
                                  1,0: tile_hydro_power_n;     1,1: tile_hydro_power_s; }
tilelayout layout_hydro_dam_nw  { 1,0: tile_hydro_dam_n_nw;    0,0: tile_hydro_dam_s_nw;
                                  1,1: tile_hydro_power_n_nw;  0,1: tile_hydro_power_s_nw; }
tilelayout layout_hydro_dam_sw  { 1,1: tile_hydro_dam_n_sw;    1,0: tile_hydro_dam_s_sw;
                                  0,1: tile_hydro_power_n_sw;  0,0: tile_hydro_power_s_sw; }
tilelayout layout_hydro_dam_se  { 0,1: tile_hydro_dam_n_se;    1,1: tile_hydro_dam_s_se;
                                  0,0: tile_hydro_power_n_se;  1,0: tile_hydro_power_s_se; }
tilelayout layout_tidal_station { 0,0: tile_tidal_barrage;  1,0: tile_tidal_hall; }
/* Wind farm: turbines on alternating tiles joined by service tracks. */
tilelayout layout_wind_farm_3x3 { 0,0: tile_wind_a;       1,0: tile_wind_track_x; 2,0: tile_wind_c;
                                  0,1: tile_wind_track_y; 1,1: tile_wind_kiosk;   2,1: tile_wind_track_y;
                                  0,2: tile_wind_b;       1,2: tile_wind_track_x; 2,2: tile_wind_d; }
tilelayout layout_wind_farm_line_x { 0,0: tile_wind_a; 1,0: tile_wind_track_x; 2,0: tile_wind_d; }
tilelayout layout_wind_farm_line_y { 0,0: tile_wind_c; 0,1: tile_wind_track_y; 0,2: tile_wind_b; }
tilelayout layout_wind_farm_2x2 { 0,0: tile_wind_grass;   1,0: tile_wind_b;
                                  0,1: tile_wind_c;       1,1: tile_wind_kiosk; }
tilelayout layout_solar_farm    { 0,0: tile_solar_panels;   1,0: tile_solar_panels; 2,0: tile_solar_inverter;
                                  0,1: tile_solar_control;  1,1: tile_solar_panels; 2,1: tile_solar_panels; }
tilelayout layout_substation    { 0,0: tile_sub_transformers; 1,0: tile_sub_pylon; }
tilelayout layout_coal_plant    { 0,0: tile_coal_boiler;      1,0: tile_coal_yard; }


/* ── PRODUCE BLOCKS ────────────────────────────────────────────── */
produce(prod_uran_6,  0, 0, 0, 6,  0, 0);

produce(prod_powr_12, 0, 0, 0, 12, 0, 0);
produce(prod_powr_10, 0, 0, 0, 10, 0, 0);
produce(prod_powr_8,  0, 0, 0, 8,  0, 0);
produce(prod_powr_6,  0, 0, 0, 6,  0, 0);

/* ═══════════════════════════════════════════════════════════
   LOCATION CHECK CALLBACKS  (use configurable parameters)
   ═══════════════════════════════════════════════════════════ */

/* Hydro: quick pre-check that water is close. water_distance is measured from
   the site's north tile, and the sw/se layouts have their water two tiles from it.
   The dam wall tiles then check for water directly on their water side
   (sw_tile_check_hydro_*), so the dam always meets a river, lake or canal. */
switch(FEAT_INDUSTRIES, SELF, sw_location_hydro, water_distance <= 2) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Tidal: directly coast-adjacent */
switch(FEAT_INDUSTRIES, SELF, sw_location_tidal, water_distance <= 1) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Wind: above param_wind_min_height */
switch(FEAT_INDUSTRIES, SELF, sw_location_wind,
       nearby_tile_height(0, 0) >= param_wind_min_height) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Solar: flat land only */
switch(FEAT_INDUSTRIES, SELF, sw_location_solar, nearby_tile_slope(0, 0)) {
    0: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* ═══════════════════════════════════════════════════════════
   CONSTRUCTION PROBABILITY — year-gated via parameters
   ═══════════════════════════════════════════════════════════ */

switch(FEAT_INDUSTRIES, SELF, sw_prob_uranium,  param_debug_all_available || current_year >= 1953)              { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_hydro,    param_debug_all_available || current_year >= param_hydro_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_nuclear,  param_debug_all_available || current_year >= param_nuclear_year){ 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_tidal,    param_debug_all_available || current_year >= param_tidal_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_wind,     param_debug_all_available || current_year >= param_wind_year)   { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_solar,    param_debug_all_available || current_year >= param_solar_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }

/* ═══════════════════════════════════════════════════════════
   WORKER MECHANIC — monthly production change callbacks
   All generators accept PASS. param_workers_required toggles this.
   ═══════════════════════════════════════════════════════════ */

/* Decrementing at the minimum production level (4) closes the industry.
   Missing workers should only reduce output, so hold at the minimum instead. */
switch(FEAT_INDUSTRIES, SELF, sw_workers_decrement, production_level) {
    0..4: CB_RESULT_IND_PROD_NO_CHANGE;
    CB_RESULT_IND_PROD_DECREMENT_BY_1;
}

/* Days since workers last arrived → production change */
switch(FEAT_INDUSTRIES, SELF, sw_workers_days_inner,
       current_date - last_cargo_accepted_at("PASS")) {
    0..60:   CB_RESULT_IND_PROD_INCREMENT_BY_1;
    61..180: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_workers_decrement;
}

/* Toggle via parameter */
switch(FEAT_INDUSTRIES, SELF, sw_workers_days, param_workers_required) {
    0: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_workers_days_inner;
}

/* Grace period for newly-built industries */
switch(FEAT_INDUSTRIES, SELF, sw_workers_grace, current_date - build_date) {
    0..90: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_workers_days;
}

/* ═══════════════════════════════════════════════════════════
   COAL POWER STATION OVERRIDE — closure timeline
   ═══════════════════════════════════════════════════════════ */

switch(FEAT_INDUSTRIES, SELF, sw_coal_construction,
       current_year >= param_coal_stop_year) {
    0: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
    CB_RESULT_IND_NO_CONSTRUCTION;
}

switch(FEAT_INDUSTRIES, SELF, sw_coal_closure_25pct, random_bits & 3) {
    0:    CB_RESULT_IND_PROD_CLOSE;
    CB_RESULT_IND_PROD_NO_CHANGE;
}
switch(FEAT_INDUSTRIES, SELF, sw_coal_closure_75pct, random_bits & 3) {
    0..2: CB_RESULT_IND_PROD_CLOSE;
    CB_RESULT_IND_PROD_NO_CHANGE;
}
switch(FEAT_INDUSTRIES, SELF, sw_coal_random_prod, current_year >= param_coal_close_year) {
    0: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_coal_closure_25pct;
}
/* Accelerated closure 20 years after phaseout start */
switch(FEAT_INDUSTRIES, SELF, sw_coal_random_prod_late,
       current_year >= (param_coal_close_year + 20)) {
    1: return sw_coal_closure_75pct;
    return sw_coal_random_prod;
}

/* ═══════════════════════════════════════════════════════════
   INDUSTRIES
   ═══════════════════════════════════════════════════════════ */

/* ── URANIUM MINE ── */
item(FEAT_INDUSTRIES, industry_uranium_mine, 0) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_URANIUM_MINE); nearby_station_name: string(STR_STAT_URANIUM_MINE);
        layouts: [layout_uranium_mine]; life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: COLOUR_PALE_GREEN; cargo_types: [produce_cargo("URAN", 3)];
        fund_cost_multiplier: 100;
        closure_msg: string(STR_NEWS_URANIUM_CLOSE); prod_increase_msg: string(STR_NEWS_URANIUM_UP);
        prod_decrease_msg: string(STR_NEWS_URANIUM_DOWN); new_ind_msg: string(STR_NEWS_URANIUM_NEW);
        prospect_chance: 0x18000000; prob_in_game: param_prob_uranium; prob_random: param_prob_uranium;
        spec_flags: bitmask(IND_FLAG_ALLOW_CLOSING_LAST_INSTANCE);
    }
    graphics { construction_probability: sw_prob_uranium; produce_256_ticks: prod_uran_6; }
}

/* ── NUCLEAR POWER PLANT ── */
item(FEAT_INDUSTRIES, industry_nuclear_plant, 1) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_NUCLEAR_PLANT); nearby_station_name: string(STR_STAT_NUCLEAR_PLANT);
        layouts: [layout_nuclear_plant]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_RED;
        cargo_types: [accept_cargo("PASS"), accept_cargo("URAN", produce_cargo("POWR", 1)), produce_cargo("POWR", 10)];
        fund_cost_multiplier: 200;
        closure_msg: string(STR_NEWS_NUCLEAR_CLOSE); prod_increase_msg: string(STR_NEWS_NUCLEAR_UP);
        prod_decrease_msg: string(STR_NEWS_NUCLEAR_DOWN); new_ind_msg: string(STR_NEWS_NUCLEAR_NEW);
        prospect_chance: 0x10000000; prob_in_game: param_prob_nuclear; prob_random: param_prob_nuclear; spec_flags: 0;
    }
    graphics {
        construction_probability: sw_prob_nuclear;
        monthly_prod_change: sw_workers_grace;
        /* No produce_256_ticks or produce_cargo_arrival: URAN->POWR conversion
           is handled entirely by cargo_types. Without uranium delivery, zero POWR. */
    }
}

/* ── HYDROELECTRIC DAM ── */
item(FEAT_INDUSTRIES, industry_hydro_dam, 2) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_HYDRO_DAM); nearby_station_name: string(STR_STAT_HYDRO_DAM);
        layouts: [layout_hydro_dam, layout_hydro_dam_nw, layout_hydro_dam_sw, layout_hydro_dam_se]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_DARK_BLUE;
        cargo_types: [accept_cargo("PASS"), produce_cargo("POWR", 6)];
        fund_cost_multiplier: 80;
        closure_msg: string(STR_NEWS_HYDRO_CLOSE); prod_increase_msg: string(STR_NEWS_HYDRO_UP);
        prod_decrease_msg: string(STR_NEWS_HYDRO_DOWN); new_ind_msg: string(STR_NEWS_HYDRO_NEW);
        prospect_chance: 0x18000000; prob_in_game: param_prob_hydro; prob_random: param_prob_hydro; spec_flags: 0;
    }
    graphics {
        construction_probability: sw_prob_hydro;
        location_check: sw_location_hydro;
        monthly_prod_change: sw_workers_grace;
        produce_256_ticks: prod_powr_12;
    }
}

