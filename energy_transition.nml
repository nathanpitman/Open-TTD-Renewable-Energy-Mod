/* Tiles 27 and 28 were the Coal Power Station's own art before it went back
   to the default power station. Keep the IDs so plants built in older saves
   still draw as a power station: base tiles 7 and 8 are its buildings. */
item(FEAT_INDUSTRYTILES, tile_old_coal_boiler,   27) { property { substitute:7; land_shape_flags:0; } }
item(FEAT_INDUSTRYTILES, tile_old_coal_yard,     28) { property { substitute:8; land_shape_flags:0; } }
/* Wind farm spacing tiles: turbines never sit on adjacent tiles, so rotors don't overlap. */
item(FEAT_INDUSTRYTILES, tile_wind_track_x,      29) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(32); } }
item(FEAT_INDUSTRYTILES, tile_wind_track_y,      30) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(33); } }
item(FEAT_INDUSTRYTILES, tile_wind_kiosk,        31) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm(34); } }

/* ── WIND TURBINES: rotor animation ──
   The wind_farm sheet holds 8 rotor frames per turbine (WIND_FRAMES in
   tools/make_sprites.py): turbine k's frame f is sprite k * 8 + f, and the
   track and kiosk tiles follow at 32-34.
   animation_frame loops 0-7 at the same moment on every turbine, so each
   tile adds its own random bits to start at a different point in the turn.
   Animation starts when the tile is built, and the tile-loop trigger
   restarts it on turbines built before animation existed (older saves).
   Speed 3 moves one frame every 8 ticks: about 1.7 s per third of a turn,
   close to a real turbine's 12 rpm. */

item(FEAT_INDUSTRYTILES, tile_wind_a, 18) {
    property { substitute:0; land_shape_flags:0; animation_info: [ANIMATION_LOOPING, 8]; animation_speed: 3;
               animation_triggers: bitmask(ANIM_TRIGGER_INDTILE_CONSTRUCTION_STATE, ANIM_TRIGGER_INDTILE_TILE_LOOP); }
    graphics { anim_control: return CB_RESULT_START_ANIMATION; default: sl_wind_farm(0 * 8 + (animation_frame + random_bits) % 8); }
}
item(FEAT_INDUSTRYTILES, tile_wind_b, 19) {
    property { substitute:0; land_shape_flags:0; animation_info: [ANIMATION_LOOPING, 8]; animation_speed: 3;
               animation_triggers: bitmask(ANIM_TRIGGER_INDTILE_CONSTRUCTION_STATE, ANIM_TRIGGER_INDTILE_TILE_LOOP); }
    graphics { anim_control: return CB_RESULT_START_ANIMATION; default: sl_wind_farm(1 * 8 + (animation_frame + random_bits) % 8); }
}
item(FEAT_INDUSTRYTILES, tile_wind_c, 20) {
    property { substitute:0; land_shape_flags:0; animation_info: [ANIMATION_LOOPING, 8]; animation_speed: 3;
               animation_triggers: bitmask(ANIM_TRIGGER_INDTILE_CONSTRUCTION_STATE, ANIM_TRIGGER_INDTILE_TILE_LOOP); }
    graphics { anim_control: return CB_RESULT_START_ANIMATION; default: sl_wind_farm(2 * 8 + (animation_frame + random_bits) % 8); }
}
item(FEAT_INDUSTRYTILES, tile_wind_d, 21) {
    property { substitute:0; land_shape_flags:0; animation_info: [ANIMATION_LOOPING, 8]; animation_speed: 3;
               animation_triggers: bitmask(ANIM_TRIGGER_INDTILE_CONSTRUCTION_STATE, ANIM_TRIGGER_INDTILE_TILE_LOOP); }
    graphics { anim_control: return CB_RESULT_START_ANIMATION; default: sl_wind_farm(3 * 8 + (animation_frame + random_bits) % 8); }
}
item(FEAT_INDUSTRYTILES, tile_wind_grass,        32) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_wind_farm_grass; } }

/* ── TILE LAYOUTS ──────────────────────────────────────────────── */
/* x runs to the lower-left of the screen, y to the lower-right; 0,0 is the back (north) tile. */
tilelayout layout_uranium_mine  { 0,0: tile_uranium_headframe; 1,0: tile_uranium_mill;
                                  0,1: tile_uranium_tailings;  1,1: tile_uranium_ore; }
tilelayout layout_nuclear_plant { 0,0: tile_nuc_cooling;    0,1: tile_nuc_cooling;  0,2: tile_nuc_switchyard;
                                  1,0: tile_nuc_turbine2;   1,1: tile_nuc_reactor;  1,2: tile_nuc_turbine;
                                  2,0: tile_nuc_intake;     2,1: tile_nuc_admin;    2,2: tile_nuc_tanks; }
/* Hydro dam across a river 1, 2 or 3 tiles wide: bank, wall, bank. The
   spillway is the middle wall tile (the first of two). Each width comes
   with the power house on either bank, in both river directions. */
tilelayout layout_hydro_x1_ps { 0,0: tile_hydro_power_start_x;    1,0: tile_hydro_spillway_x; 2,0: tile_hydro_abutment_end_x; }
tilelayout layout_hydro_x1_pe { 0,0: tile_hydro_abutment_start_x; 1,0: tile_hydro_spillway_x; 2,0: tile_hydro_power_end_x; }
tilelayout layout_hydro_x2_ps { 0,0: tile_hydro_power_start_x;    1,0: tile_hydro_spillway_x; 2,0: tile_hydro_wall_x;     3,0: tile_hydro_abutment_end_x; }
tilelayout layout_hydro_x2_pe { 0,0: tile_hydro_abutment_start_x; 1,0: tile_hydro_spillway_x; 2,0: tile_hydro_wall_x;     3,0: tile_hydro_power_end_x; }
tilelayout layout_hydro_x3_ps { 0,0: tile_hydro_power_start_x;    1,0: tile_hydro_wall_x;     2,0: tile_hydro_spillway_x; 3,0: tile_hydro_wall_x; 4,0: tile_hydro_abutment_end_x; }
tilelayout layout_hydro_x3_pe { 0,0: tile_hydro_abutment_start_x; 1,0: tile_hydro_wall_x;     2,0: tile_hydro_spillway_x; 3,0: tile_hydro_wall_x; 4,0: tile_hydro_power_end_x; }
tilelayout layout_hydro_y1_ps { 0,0: tile_hydro_power_start_y;    0,1: tile_hydro_spillway_y; 0,2: tile_hydro_abutment_end_y; }
tilelayout layout_hydro_y1_pe { 0,0: tile_hydro_abutment_start_y; 0,1: tile_hydro_spillway_y; 0,2: tile_hydro_power_end_y; }
tilelayout layout_hydro_y2_ps { 0,0: tile_hydro_power_start_y;    0,1: tile_hydro_spillway_y; 0,2: tile_hydro_wall_y;     0,3: tile_hydro_abutment_end_y; }
tilelayout layout_hydro_y2_pe { 0,0: tile_hydro_abutment_start_y; 0,1: tile_hydro_spillway_y; 0,2: tile_hydro_wall_y;     0,3: tile_hydro_power_end_y; }
tilelayout layout_hydro_y3_ps { 0,0: tile_hydro_power_start_y;    0,1: tile_hydro_wall_y;     0,2: tile_hydro_spillway_y; 0,3: tile_hydro_wall_y; 0,4: tile_hydro_abutment_end_y; }
tilelayout layout_hydro_y3_pe { 0,0: tile_hydro_abutment_start_y; 0,1: tile_hydro_wall_y;     0,2: tile_hydro_spillway_y; 0,3: tile_hydro_wall_y; 0,4: tile_hydro_power_end_y; }
tilelayout layout_tidal_station { 0,0: tile_tidal_barrage;  1,0: tile_tidal_hall; }
/* Wind farm: turbines on alternating tiles joined by service tracks. */
tilelayout layout_wind_farm_3x3 { 0,0: tile_wind_a;       1,0: tile_wind_track_x; 2,0: tile_wind_c;
                                  0,1: tile_wind_track_y; 1,1: tile_wind_kiosk;   2,1: tile_wind_track_y;
                                  0,2: tile_wind_b;       1,2: tile_wind_track_x; 2,2: tile_wind_d; }
tilelayout layout_wind_farm_line_x { 0,0: tile_wind_a; 1,0: tile_wind_track_x; 2,0: tile_wind_d; }
tilelayout layout_wind_farm_line_y { 0,0: tile_wind_c; 0,1: tile_wind_track_y; 0,2: tile_wind_b; }
tilelayout layout_wind_farm_2x2 { 0,0: tile_wind_grass;   1,0: tile_wind_b;
                                  0,1: tile_wind_c;       1,1: tile_wind_kiosk; }
tilelayout layout_solar_farm    { 0,0: tile_solar_panels;   1,0: tile_solar_panels; 2,0: tile_solar_inverter;
                                  0,1: tile_solar_control;  1,1: tile_solar_panels; 2,1: tile_solar_panels; }
tilelayout layout_substation    { 0,0: tile_sub_transformers; 1,0: tile_sub_switchgear; }


/* ── PRODUCTION ────────────────────────────────────────────────── */
/* Output comes only from each industry's produce_cargo() rate in cargo_types,
   which OpenTTD adds every 256 ticks. Don't also add a produce_256_ticks
   callback: its output would be added on top of the rate. */

/* ═══════════════════════════════════════════════════════════
   LOCATION CHECK CALLBACKS  (use configurable parameters)
   ═══════════════════════════════════════════════════════════ */

/* Tidal: directly coast-adjacent */
switch(FEAT_INDUSTRIES, SELF, sw_location_tidal, water_distance <= 1) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Wind: above param_wind_min_height */
switch(FEAT_INDUSTRIES, SELF, sw_location_wind,
       nearby_tile_height(0, 0) >= param_wind_min_height) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Solar: flat land only */
switch(FEAT_INDUSTRIES, SELF, sw_location_solar, nearby_tile_slope(0, 0)) {
    0: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* ═══════════════════════════════════════════════════════════
   CONSTRUCTION PROBABILITY — year-gated via parameters
   ═══════════════════════════════════════════════════════════ */

switch(FEAT_INDUSTRIES, SELF, sw_prob_uranium,  param_debug_all_available || current_year >= 1953)              { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_hydro,    param_debug_all_available || current_year >= param_hydro_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_nuclear,  param_debug_all_available || current_year >= param_nuclear_year){ 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_tidal,    param_debug_all_available || current_year >= param_tidal_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_wind,     param_debug_all_available || current_year >= param_wind_year)   { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_solar,    param_debug_all_available || current_year >= param_solar_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }

/* ═══════════════════════════════════════════════════════════
   COAL POWER STATION OVERRIDE — closure timeline
   ═══════════════════════════════════════════════════════════ */

switch(FEAT_INDUSTRIES, SELF, sw_coal_construction,
       current_year >= param_coal_stop_year) {
    0: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
    CB_RESULT_IND_NO_CONSTRUCTION;
}

switch(FEAT_INDUSTRIES, SELF, sw_coal_closure_25pct, random_bits & 3) {
    0:    CB_RESULT_IND_PROD_CLOSE;
    CB_RESULT_IND_PROD_NO_CHANGE;
}
switch(FEAT_INDUSTRIES, SELF, sw_coal_closure_75pct, random_bits & 3) {
    0..2: CB_RESULT_IND_PROD_CLOSE;
    CB_RESULT_IND_PROD_NO_CHANGE;
}
switch(FEAT_INDUSTRIES, SELF, sw_coal_random_prod, current_year >= param_coal_close_year) {
    0: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_coal_closure_25pct;
}
/* Accelerated closure 20 years after phaseout start */
switch(FEAT_INDUSTRIES, SELF, sw_coal_random_prod_late,
       current_year >= (param_coal_close_year + 20)) {
    1: return sw_coal_closure_75pct;
    return sw_coal_random_prod;
}

/* ═══════════════════════════════════════════════════════════
   INDUSTRIES
   ═══════════════════════════════════════════════════════════ */

/* ── URANIUM MINE ── */
item(FEAT_INDUSTRIES, industry_uranium_mine, 0) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_URANIUM_MINE); nearby_station_name: string(STR_STAT_URANIUM_MINE);
        layouts: [layout_uranium_mine]; life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: COLOUR_PALE_GREEN; cargo_types: [produce_cargo("URAN", 6)];
        fund_cost_multiplier: 100;
        closure_msg: string(STR_NEWS_URANIUM_CLOSE); prod_increase_msg: string(STR_NEWS_URANIUM_UP);
        prod_decrease_msg: string(STR_NEWS_URANIUM_DOWN); new_ind_msg: string(STR_NEWS_URANIUM_NEW);
        prospect_chance: 0x18000000; prob_in_game: param_prob_uranium; prob_random: param_prob_uranium;
        spec_flags: bitmask(IND_FLAG_ALLOW_CLOSING_LAST_INSTANCE);
    }
    graphics { construction_probability: sw_prob_uranium; }
}

/* ── NUCLEAR POWER PLANT ── */
item(FEAT_INDUSTRIES, industry_nuclear_plant, 1) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_NUCLEAR_PLANT); nearby_station_name: string(STR_STAT_NUCLEAR_PLANT);
        layouts: [layout_nuclear_plant]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_RED;
        cargo_types: [accept_cargo("URAN", produce_cargo("POWR", 1)), produce_cargo("POWR", 0)];
        fund_cost_multiplier: 200;
        closure_msg: string(STR_NEWS_NUCLEAR_CLOSE); prod_increase_msg: string(STR_NEWS_NUCLEAR_UP);
        prod_decrease_msg: string(STR_NEWS_NUCLEAR_DOWN); new_ind_msg: string(STR_NEWS_NUCLEAR_NEW);
        prospect_chance: 0x10000000; prob_in_game: param_prob_nuclear; prob_random: param_prob_nuclear; spec_flags: 0;
    }
    graphics {
        construction_probability: sw_prob_nuclear;
        /* Power comes only from uranium: each tonne delivered becomes 1 MWh
           (the 1 in accept_cargo is a 1:1 ratio). The base POWR rate is 0,
           so without uranium deliveries the plant makes no power. */
    }
}

/* ── HYDROELECTRIC DAM ── */
item(FEAT_INDUSTRIES, industry_hydro_dam, 2) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_HYDRO_DAM); nearby_station_name: string(STR_STAT_HYDRO_DAM);
        layouts: [layout_hydro_x1_ps, layout_hydro_x1_pe, layout_hydro_x2_ps, layout_hydro_x2_pe, layout_hydro_x3_ps, layout_hydro_x3_pe,
                  layout_hydro_y1_ps, layout_hydro_y1_pe, layout_hydro_y2_ps, layout_hydro_y2_pe, layout_hydro_y3_ps, layout_hydro_y3_pe];
        life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_DARK_BLUE;
        cargo_types: [produce_cargo("POWR", 12)];
        fund_cost_multiplier: 80;
        closure_msg: string(STR_NEWS_HYDRO_CLOSE); prod_increase_msg: string(STR_NEWS_HYDRO_UP);
        prod_decrease_msg: string(STR_NEWS_HYDRO_DOWN); new_ind_msg: string(STR_NEWS_HYDRO_NEW);
        prospect_chance: 0x18000000; prob_in_game: param_prob_hydro; prob_random: param_prob_hydro; spec_flags: 0;
    }
    graphics {
        construction_probability: sw_prob_hydro;
        /* Placement is checked tile by tile: see sw_tile_check_hydro_*. */
    }
}

/* ── TIDAL POWER STATION ── */
item(FEAT_INDUSTRIES, industry_tidal_station, 3) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_TIDAL_STATION); nearby_station_name: string(STR_STAT_TIDAL_STATION);
        layouts: [layout_tidal_station]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_LIGHT_BLUE;
        cargo_types: [produce_cargo("POWR", 10)];
        fund_cost_multiplier: 60;
        closure_msg: string(STR_NEWS_TIDAL_CLOSE); prod_increase_msg: string(STR_NEWS_TIDAL_UP);
        prod_decrease_msg: string(STR_NEWS_TIDAL_DOWN); new_ind_msg: string(STR_NEWS_TIDAL_NEW);
        prospect_chance: 0x20000000; prob_in_game: param_prob_tidal; prob_random: param_prob_tidal;
        spec_flags: bitmask(IND_FLAG_BUILT_ONLY_AFTER_1960);
    }
    graphics {
        construction_probability: sw_prob_tidal;
        location_check: sw_location_tidal;
    }
}

/* ── WIND FARM ── */
item(FEAT_INDUSTRIES, industry_wind_farm, 4) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_WIND_FARM); nearby_station_name: string(STR_STAT_WIND_FARM);
        layouts: [layout_wind_farm_3x3, layout_wind_farm_line_x, layout_wind_farm_line_y, layout_wind_farm_2x2];
        life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_PALE_GREEN;
        cargo_types: [produce_cargo("POWR", 8)];
        fund_cost_multiplier: 50;
        closure_msg: string(STR_NEWS_WIND_CLOSE); prod_increase_msg: string(STR_NEWS_WIND_UP);
        prod_decrease_msg: string(STR_NEWS_WIND_DOWN); new_ind_msg: string(STR_NEWS_WIND_NEW);
        prospect_chance: 0x30000000; prob_in_game: param_prob_wind; prob_random: param_prob_wind;
        spec_flags: bitmask(IND_FLAG_BUILT_ONLY_AFTER_1960);
    }
    graphics {
        construction_probability: sw_prob_wind;
        location_check: sw_location_wind;
    }
}

/* ── SOLAR FARM ── */
item(FEAT_INDUSTRIES, industry_solar_farm, 5) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_SOLAR_FARM); nearby_station_name: string(STR_STAT_SOLAR_FARM);
        layouts: [layout_solar_farm]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_YELLOW;
        cargo_types: [produce_cargo("POWR", 6)];
        fund_cost_multiplier: 40;
        closure_msg: string(STR_NEWS_SOLAR_CLOSE); prod_increase_msg: string(STR_NEWS_SOLAR_UP);
        prod_decrease_msg: string(STR_NEWS_SOLAR_DOWN); new_ind_msg: string(STR_NEWS_SOLAR_NEW);
        prospect_chance: 0x28000000; prob_in_game: param_prob_solar; prob_random: param_prob_solar;
        spec_flags: bitmask(IND_FLAG_BUILT_ONLY_AFTER_1960);
    }
    graphics {
        construction_probability: sw_prob_solar;
        location_check: sw_location_solar;
    }
}

/* ── ELECTRICAL SUBSTATION ── */
item(FEAT_INDUSTRIES, industry_substation, 6) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_SUBSTATION); nearby_station_name: string(STR_STAT_SUBSTATION);
        layouts: [layout_substation]; life_type: IND_LIFE_TYPE_PROCESSING;
        map_colour: COLOUR_GREY;
        cargo_types: [accept_cargo("POWR")];
        fund_cost_multiplier: 30;
        closure_msg: string(STR_NEWS_SUBSTATION_CLOSE); prod_increase_msg: string(STR_NEWS_SUBSTATION_UP);
        prod_decrease_msg: string(STR_NEWS_SUBSTATION_DOWN); new_ind_msg: string(STR_NEWS_SUBSTATION_NEW);
        prospect_chance: 0x38000000;
        prob_in_game: param_substation_prob;
        prob_random:  param_substation_prob;
        spec_flags: bitmask(IND_FLAG_BUILT_NEAR_TOWN);
    }
}

/* ── COAL POWER STATION OVERRIDE ── */
item(FEAT_INDUSTRIES, ind_coal_power_plant, 7) {
    property {
        substitute:  INDUSTRYTYPE_POWER_PLANT;
        override:    INDUSTRYTYPE_POWER_PLANT;
        /* No `layouts`: the substitute's default layouts and tiles are kept,
           so it looks like the base game's power station. */
        name: string(STR_IND_COAL_PLANT); nearby_station_name: string(STR_STAT_COAL_PLANT);
        life_type: IND_LIFE_TYPE_PROCESSING;
        map_colour: COLOUR_GREY;
        cargo_types: [accept_cargo("COAL")];
        fund_cost_multiplier: 160;
        closure_msg: string(STR_NEWS_COAL_CLOSE); prod_increase_msg: string(STR_NEWS_COAL_UP);
        prod_decrease_msg: string(STR_NEWS_COAL_DOWN); new_ind_msg: string(STR_NEWS_COAL_NEW);
        prospect_chance: 0x00000000; prob_in_game: 2; prob_random: 2;
        spec_flags: bitmask(IND_FLAG_ALLOW_CLOSING_LAST_INSTANCE);
    }
    graphics {
        construction_probability: sw_coal_construction;
        random_prod_change:       sw_coal_random_prod_late;
    }
}
