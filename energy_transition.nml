alternative_sprites(ss_hydro_dam, ZOOM_LEVEL_IN_2X, BIT_DEPTH_8BPP, "sprites/hydro_dam_2x.png") { [0,0,128,136,-62,-72] [128,0,128,136,-62,-72] [256,0,128,136,-62,-72, ANIM] [384,0,128,136,-62,-72] [512,0,128,136,-62,-72] [640,0,128,136,-62,-72] [768,0,128,136,-62,-72, ANIM] [896,0,128,136,-62,-72] [1024,0,128,136,-62,-72] [1152,0,128,136,-62,-72] [1280,0,128,136,-62,-72, ANIM] [1408,0,128,136,-62,-72] [1536,0,128,136,-62,-72] [1664,0,128,136,-62,-72] [1792,0,128,136,-62,-72, ANIM] [1920,0,128,136,-62,-72] }
