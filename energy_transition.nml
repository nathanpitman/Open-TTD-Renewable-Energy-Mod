/* ── SPRITELAYOUTS ─────────────────────────────────────────────── */
/* Parameters: tile = sprite index in the industry sheet,
               gnd  = ss_ground index (0 grass, 1 dirt, 2 concrete, 3 water, 4 shore) */
spritelayout sl_hydro_dam(tile, gnd) {
    ground { sprite: ss_ground(gnd); }
    building { sprite: ss_hydro_dam(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:32; }
}
spritelayout sl_uranium_mine(tile) {
    ground { sprite: ss_ground(1); }
    building { sprite: ss_uranium_mine(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:36; }
}
spritelayout sl_nuclear_plant(tile) {
    ground { sprite: ss_ground(2); }
    building { sprite: ss_nuclear_plant(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:52; }
}
spritelayout sl_tidal_station(tile) {
    ground { sprite: ss_ground(4); }
    building { sprite: ss_tidal_station(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:13; }
}
spritelayout sl_wind_farm(tile) {
    ground { sprite: ss_ground(0); }
    building { sprite: ss_wind_farm(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:45; }
}
spritelayout sl_wind_farm_grass {
    ground { sprite: ss_ground(0); }
}
spritelayout sl_solar_farm(tile) {
    ground { sprite: ss_ground(0); }
    building { sprite: ss_solar_farm(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:7; }
}
spritelayout sl_substation(tile) {
    ground { sprite: ss_ground(2); }
    building { sprite: ss_substation(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:34; }
}
spritelayout sl_coal_power_plant(tile) {
    ground { sprite: ss_ground(1); }
    building { sprite: ss_coal_power_plant(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:48; }
}

/* ── INDUSTRY TILES ────────────────────────────────────────────── */
/* One tile type per distinct piece of art, so multi-tile industries read
   as a single structure instead of a repeated icon.
   No tile sets `override`: that would replace a base-game industry tile
   (override:0 is the coal mine's) with our art. */

/* Hydro dam: four facings, named after the side the water is on
   (ne = x - 1, nw = y - 1, sw = x + 1, se = y + 1). Each dam wall tile must
   have real water on that side, so the dam always meets a river, lake or canal. */
switch(FEAT_INDUSTRYTILES, SELF, sw_tile_check_hydro_ne, nearby_tile_is_water(-1, 0)) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}
switch(FEAT_INDUSTRYTILES, SELF, sw_tile_check_hydro_nw, nearby_tile_is_water(0, -1)) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}
switch(FEAT_INDUSTRYTILES, SELF, sw_tile_check_hydro_sw, nearby_tile_is_water(1, 0)) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}
switch(FEAT_INDUSTRYTILES, SELF, sw_tile_check_hydro_se, nearby_tile_is_water(0, 1)) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}
item(FEAT_INDUSTRYTILES, tile_hydro_dam_n,         0) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_ne; default: sl_hydro_dam(0, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam_s,         1) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_ne; default: sl_hydro_dam(1, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_n,       2) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(2, 0); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_s,       3) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(3, 0); } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam_n_nw,     33) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_nw; default: sl_hydro_dam(4, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam_s_nw,     34) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_nw; default: sl_hydro_dam(5, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_n_nw,   35) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(6, 0); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_s_nw,   36) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(7, 0); } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam_n_sw,     37) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_sw; default: sl_hydro_dam(8, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam_s_sw,     38) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_sw; default: sl_hydro_dam(9, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_n_sw,   39) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(10, 0); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_s_sw,   40) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(11, 0); } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam_n_se,     41) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_se; default: sl_hydro_dam(12, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam_s_se,     42) { property { substitute:0; land_shape_flags:0; } graphics { tile_check: sw_tile_check_hydro_se; default: sl_hydro_dam(13, 3); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_n_se,   43) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(14, 0); } }
item(FEAT_INDUSTRYTILES, tile_hydro_power_s_se,   44) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_hydro_dam(15, 0); } }
item(FEAT_INDUSTRYTILES, tile_uranium_headframe,  4) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_uranium_mine(0); } }
item(FEAT_INDUSTRYTILES, tile_uranium_tailings,   5) { property { substitute:0; land_shape_flags:0; } graphics { default: sl_uranium_mine(1); } }
