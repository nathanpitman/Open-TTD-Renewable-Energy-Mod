/*
 * Energy Transition Industries — OpenTTD NewGRF v14
 * ==================================================
 * Full energy economy with configurable parameters.
 *
 * Cargo chain:
 *   Generators → POWR → Substation → town growth
 *   Uranium Mine → URAN → Nuclear Power Plant → POWR → Substation
 *
 * Hydro, tidal, wind and solar need no deliveries. Coal power stations are
 * overridden to stop spawning after param_coal_stop_year, and close
 * stochastically after param_coal_close_year.
 */

grf {
    grfid: "RE01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 14;
    min_compatible_version: 1;

    /* ── ERA DATES ─────────────────────────────────────────────── */
    param {
        param_hydro_year {
            type: int;
            name: string(STR_PARAM_HYDRO_YEAR_NAME);
            desc: string(STR_PARAM_HYDRO_YEAR_DESC);
            min_value: 1930;  max_value: 1960;  def_value: 1950;
        }
    }
    param {
        param_nuclear_year {
            type: int;
            name: string(STR_PARAM_NUCLEAR_YEAR_NAME);
            desc: string(STR_PARAM_NUCLEAR_YEAR_DESC);
            min_value: 1950;  max_value: 1975;  def_value: 1956;
        }
    }
    param {
        param_tidal_year {
            type: int;
            name: string(STR_PARAM_TIDAL_YEAR_NAME);
            desc: string(STR_PARAM_TIDAL_YEAR_DESC);
            min_value: 1960;  max_value: 1985;  def_value: 1966;
        }
    }
    param {
        param_wind_year {
            type: int;
            name: string(STR_PARAM_WIND_YEAR_NAME);
            desc: string(STR_PARAM_WIND_YEAR_DESC);
            min_value: 1970;  max_value: 1995;  def_value: 1980;
        }
    }
    param {
        param_solar_year {
            type: int;
            name: string(STR_PARAM_SOLAR_YEAR_NAME);
            desc: string(STR_PARAM_SOLAR_YEAR_DESC);
            min_value: 1980;  max_value: 2005;  def_value: 1990;
        }
    }
    param {
        param_coal_stop_year {
            type: int;
            name: string(STR_PARAM_COAL_STOP_NAME);
            desc: string(STR_PARAM_COAL_STOP_DESC);
            min_value: 1960;  max_value: 1990;  def_value: 1970;
        }
    }
    param {
        param_coal_close_year {
            type: int;
            name: string(STR_PARAM_COAL_CLOSE_NAME);
            desc: string(STR_PARAM_COAL_CLOSE_DESC);
            min_value: 1980;  max_value: 2020;  def_value: 1990;
        }
    }

    /* ── PLACEMENT ─────────────────────────────────────────────── */
    /* Parameter 7 was the hydro water distance, removed in favour of the
       dam's own water check. Numbering resumes at 8 so saved values for
       the parameters below keep their meaning. Don't reuse 7. */
    param 8 {
        param_wind_min_height {
            type: int;
            name: string(STR_PARAM_WIND_HEIGHT_NAME);
            desc: string(STR_PARAM_WIND_HEIGHT_DESC);
            min_value: 0;  max_value: 8;  def_value: 4;
        }
    }
    param {
        param_substation_prob {
            type: int;
            name: string(STR_PARAM_SUBSTATION_PROB_NAME);
            desc: string(STR_PARAM_SUBSTATION_PROB_DESC);
            min_value: 1;  max_value: 10;  def_value: 5;
        }
    }

    /* ── SPAWN RATES ───────────────────────────────────────────── */
    /* Parameter 10 was "workers required", removed along with the worker
       mechanic. Numbering resumes at 11 so saved values for the parameters
       below keep their meaning. Don't reuse 10. */
    param 11 {
        param_prob_hydro {
            type: int;
            name: string(STR_PARAM_PROB_HYDRO_NAME);
            desc: string(STR_PARAM_PROB_HYDRO_DESC);
            min_value: 0;  max_value: 8;  def_value: 1;
        }
    }
    param {
        param_prob_tidal {
            type: int;
            name: string(STR_PARAM_PROB_TIDAL_NAME);
            desc: string(STR_PARAM_PROB_TIDAL_DESC);
            min_value: 0;  max_value: 8;  def_value: 2;
        }
    }
    param {
        param_prob_wind {
            type: int;
            name: string(STR_PARAM_PROB_WIND_NAME);
            desc: string(STR_PARAM_PROB_WIND_DESC);
            min_value: 0;  max_value: 8;  def_value: 3;
        }
    }
    param {
        param_prob_solar {
            type: int;
            name: string(STR_PARAM_PROB_SOLAR_NAME);
            desc: string(STR_PARAM_PROB_SOLAR_DESC);
            min_value: 0;  max_value: 8;  def_value: 2;
        }
    }
    param {
        param_prob_nuclear {
            type: int;
            name: string(STR_PARAM_PROB_NUCLEAR_NAME);
            desc: string(STR_PARAM_PROB_NUCLEAR_DESC);
            min_value: 0;  max_value: 4;  def_value: 1;
        }
    }
    param {
        param_prob_uranium {
            type: int;
            name: string(STR_PARAM_PROB_URANIUM_NAME);
            desc: string(STR_PARAM_PROB_URANIUM_DESC);
            min_value: 0;  max_value: 4;  def_value: 2;
        }
    }

    /* ── DEBUG ─────────────────────────────────────────────────── */
    param {
        param_debug_all_available {
            type: bool;
            name: string(STR_PARAM_DEBUG_ALL_AVAILABLE_NAME);
            desc: string(STR_PARAM_DEBUG_ALL_AVAILABLE_DESC);
            def_value: 0;
        }
    }

    /* ── PLACEMENT (added later) ───────────────────────────────────── */
    /* New settings go after the existing ones so their numbers don't change. */
    param 18 {
        param_hydro_min_water {
            type: int;
            name: string(STR_PARAM_HYDRO_MIN_WATER_NAME);
            desc: string(STR_PARAM_HYDRO_MIN_WATER_DESC);
            min_value: 3;  max_value: 100;  def_value: 12;
        }
    }

}

/* ── CARGO TABLE ──────────────────────────────────────────────── */
cargotable { POWR, URAN, COAL, }

/* Cargo item IDs are global cargo slots, not GRF-local IDs. Slots 0-11 hold
 * the default cargos (0 = PASS, 1 = COAL, ...), so using them would replace
 * those cargos. Use slots the default climates leave free.
 *
 * `number` (the cargo bit) is what makes OpenTTD treat a new cargo as valid.
 * Without it the cargo is dropped, along with every industry's production and
 * acceptance of it. Each bit must be unique, so it matches the slot. */

/* ── CARGO: POWER ─────────────────────────────────────────────── */
item(FEAT_CARGOS, item_cargo_powr, 32) {
    property {
        number:                32;
        cargo_label:           "POWR";
        type_name:             string(STR_CARGO_POWER_NAME);
        unit_name:             string(STR_CARGO_POWER_SINGLE);
        type_abbreviation:     string(STR_CARGO_POWER_ABBREV);
        sprite:                NEW_CARGO_SPRITE;
        town_growth_effect:    TOWNGROWTH_GOODS;
        units_of_cargo:        string(STR_CARGO_POWER_UNIT);
        items_of_cargo:        string(STR_CARGO_POWER_ITEM);
        penalty_lowerbound:    0;
        single_penalty_length: 255;
        price_factor:          1000;
        cargo_classes:         bitmask(CC_EXPRESS);
        station_list_colour:   COLOUR_YELLOW;
        weight:                1;
        is_freight:            0;
    }
}

/* ── CARGO: URANIUM ───────────────────────────────────────────── */
item(FEAT_CARGOS, item_cargo_uran, 33) {
    property {
        number:                33;
        cargo_label:           "URAN";
        type_name:             string(STR_CARGO_URAN_NAME);
        unit_name:             string(STR_CARGO_URAN_SINGLE);
        type_abbreviation:     string(STR_CARGO_URAN_ABBREV);
        sprite:                NEW_CARGO_SPRITE;
        town_growth_effect:    TOWNGROWTH_NONE;
        units_of_cargo:        string(STR_CARGO_URAN_UNIT);
        items_of_cargo:        string(STR_CARGO_URAN_ITEM);
        penalty_lowerbound:    15;
        single_penalty_length: 40;
        price_factor:          3500;
        cargo_classes:         bitmask(CC_BULK);
        station_list_colour:   COLOUR_PALE_GREEN;
        weight:                15;
        is_freight:            1;
    }
}

/* ── SPRITESETS ────────────────────────────────────────────────── */
/* Art is generated by tools/make_sprites.py (8bpp, OpenTTD DOS palette,
   1x only; OpenTTD enlarges it when zoomed in). Each industry sheet holds one sprite per distinct tile;
   the block below is rewritten by that script so offsets always match. */
/* BEGIN GENERATED SPRITESETS - written by tools/make_sprites.py, do not edit by hand */
/* ground: 0=grass, 1=dirt, 2=concrete, 3=water, 4=shore */
spriteset(ss_ground, "sprites/ground.png") { [0,0,64,31,-31,0] [64,0,64,31,-31,0] [128,0,64,31,-31,0] [192,0,64,31,-31,0, ANIM] [256,0,64,31,-31,0, ANIM] }
/* hydro_dam: 0=hydro_dam_n, 1=hydro_dam_s, 2=hydro_power_n, 3=hydro_power_s, 4=hydro_dam_n_nw, 5=hydro_dam_s_nw, 6=hydro_power_n_nw, 7=hydro_power_s_nw, 8=hydro_dam_n_sw, 9=hydro_dam_s_sw, 10=hydro_power_n_sw, 11=hydro_power_s_sw, 12=hydro_dam_n_se, 13=hydro_dam_s_se, 14=hydro_power_n_se, 15=hydro_power_s_se, 16=hydro_wall_x, 17=hydro_spillway_x, 18=hydro_abutment_start_x, 19=hydro_abutment_end_x, 20=hydro_power_start_x, 21=hydro_power_end_x, 22=hydro_wall_y, 23=hydro_spillway_y, 24=hydro_abutment_start_y, 25=hydro_abutment_end_y, 26=hydro_power_start_y, 27=hydro_power_end_y */
spriteset(ss_hydro_dam, "sprites/hydro_dam.png") { [0,0,64,68,-31,-36] [64,0,64,68,-31,-36] [128,0,64,68,-31,-36, ANIM] [192,0,64,68,-31,-36] [256,0,64,68,-31,-36] [320,0,64,68,-31,-36] [384,0,64,68,-31,-36, ANIM] [448,0,64,68,-31,-36] [512,0,64,68,-31,-36] [576,0,64,68,-31,-36] [640,0,64,68,-31,-36, ANIM] [704,0,64,68,-31,-36] [768,0,64,68,-31,-36] [832,0,64,68,-31,-36] [896,0,64,68,-31,-36, ANIM] [960,0,64,68,-31,-36] [1024,0,64,68,-31,-36] [1088,0,64,68,-31,-36, ANIM] [1152,0,64,68,-31,-36] [1216,0,64,68,-31,-36] [1280,0,64,68,-31,-36] [1344,0,64,68,-31,-36] [1408,0,64,68,-31,-36] [1472,0,64,68,-31,-36, ANIM] [1536,0,64,68,-31,-36] [1600,0,64,68,-31,-36] [1664,0,64,68,-31,-36] [1728,0,64,68,-31,-36] }
/* uranium_mine: 0=uranium_headframe, 1=uranium_tailings, 2=uranium_mill, 3=uranium_ore */
spriteset(ss_uranium_mine, "sprites/uranium_mine.png") { [0,0,64,72,-31,-40] [64,0,64,72,-31,-40] [128,0,64,72,-31,-40] [192,0,64,72,-31,-40] }
/* nuclear_plant: 0=nuc_cooling, 1=nuc_reactor, 2=nuc_turbine, 3=nuc_turbine2, 4=nuc_admin, 5=nuc_intake, 6=nuc_switchyard, 7=nuc_tanks */
spriteset(ss_nuclear_plant, "sprites/nuclear_plant.png") { [0,0,64,92,-31,-60] [64,0,64,92,-31,-60] [128,0,64,92,-31,-60] [192,0,64,92,-31,-60] [256,0,64,92,-31,-60] [320,0,64,92,-31,-60, ANIM] [384,0,64,92,-31,-60] [448,0,64,92,-31,-60] }
/* tidal_station: 0=tidal_barrage, 1=tidal_hall */
spriteset(ss_tidal_station, "sprites/tidal_station.png") { [0,0,64,52,-31,-20, ANIM] [64,0,64,52,-31,-20] }
/* wind_farm: 0=wind_a, 1=wind_a_f1, 2=wind_a_f2, 3=wind_a_f3, 4=wind_a_f4, 5=wind_a_f5, 6=wind_a_f6, 7=wind_a_f7, 8=wind_b, 9=wind_b_f1, 10=wind_b_f2, 11=wind_b_f3, 12=wind_b_f4, 13=wind_b_f5, 14=wind_b_f6, 15=wind_b_f7, 16=wind_c, 17=wind_c_f1, 18=wind_c_f2, 19=wind_c_f3, 20=wind_c_f4, 21=wind_c_f5, 22=wind_c_f6, 23=wind_c_f7, 24=wind_d, 25=wind_d_f1, 26=wind_d_f2, 27=wind_d_f3, 28=wind_d_f4, 29=wind_d_f5, 30=wind_d_f6, 31=wind_d_f7, 32=wind_track_x, 33=wind_track_y, 34=wind_kiosk */
spriteset(ss_wind_farm, "sprites/wind_farm.png") { [0,0,64,80,-31,-48] [64,0,64,80,-31,-48] [128,0,64,80,-31,-48] [192,0,64,80,-31,-48] [256,0,64,80,-31,-48] [320,0,64,80,-31,-48] [384,0,64,80,-31,-48] [448,0,64,80,-31,-48] [512,0,64,80,-31,-48] [576,0,64,80,-31,-48] [640,0,64,80,-31,-48] [704,0,64,80,-31,-48] [768,0,64,80,-31,-48] [832,0,64,80,-31,-48] [896,0,64,80,-31,-48] [960,0,64,80,-31,-48] [1024,0,64,80,-31,-48] [1088,0,64,80,-31,-48] [1152,0,64,80,-31,-48] [1216,0,64,80,-31,-48] [1280,0,64,80,-31,-48] [1344,0,64,80,-31,-48] [1408,0,64,80,-31,-48] [1472,0,64,80,-31,-48] [1536,0,64,80,-31,-48] [1600,0,64,80,-31,-48] [1664,0,64,80,-31,-48] [1728,0,64,80,-31,-48] [1792,0,64,80,-31,-48] [1856,0,64,80,-31,-48] [1920,0,64,80,-31,-48] [1984,0,64,80,-31,-48] [2048,0,64,80,-31,-48] [2112,0,64,80,-31,-48] [2176,0,64,80,-31,-48] }
/* solar_farm: 0=solar_panels, 1=solar_inverter, 2=solar_control */
spriteset(ss_solar_farm, "sprites/solar_farm.png") { [0,0,64,44,-31,-12] [64,0,64,44,-31,-12] [128,0,64,44,-31,-12] }
/* substation: 0=sub_transformers, 1=sub_switchgear */
spriteset(ss_substation, "sprites/substation.png") { [0,0,64,72,-31,-40] [64,0,64,72,-31,-40] }
spriteset(ss_cargo_powr, "sprites/cargo_icons.png") { [0,0,10,10,0,0] }
spriteset(ss_cargo_uran, "sprites/cargo_icons.png") { [10,0,10,10,0,0] }
/* END GENERATED SPRITESETS */

/* ── CARGO ICONS ───────────────────────────────────────────────── */
/* sprite: NEW_CARGO_SPRITE (set on the cargos above) makes OpenTTD use
   these instead of a base-game icon. They can only be linked here, after
   the generated spritesets. */
item(FEAT_CARGOS, item_cargo_powr) { graphics { default: ss_cargo_powr; } }
item(FEAT_CARGOS, item_cargo_uran) { graphics { default: ss_cargo_uran; } }

/* ── SPRITELAYOUTS ─────────────────────────────────────────────── */
/* Parameters: tile = sprite index in the industry sheet,
               gnd  = ss_ground index (0 grass, 1 dirt, 2 concrete, 3 water, 4 shore)
   Grass-ground tiles don't use ss_ground(0). They draw the base set's own
   ground sprite so they match the land around them: snow above the
   sub-arctic snowline, sand in sub-tropical desert, grass everywhere else.
   GROUNDSPRITE_SNOW and GROUNDSPRITE_DESERT are the same sprite number; the
   base set draws it as snow or sand to suit the climate. */
spritelayout sl_hydro_dam(tile, gnd) {
    ground { sprite: ss_ground(gnd); }
    building { sprite: ss_hydro_dam(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:32; }
}
/* GROUNDSPRITE_WATER on a tile built over water makes OpenTTD draw that
   tile's own water (river, with its banks) underneath. */
spritelayout sl_hydro_wall(tile) {
    ground { sprite: GROUNDSPRITE_WATER; }
    building { sprite: ss_hydro_dam(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:32; }
}
spritelayout sl_hydro_power(tile) {
    ground { sprite: (terrain_type == TILETYPE_SNOW || terrain_type == TILETYPE_DESERT) ? GROUNDSPRITE_SNOW : GROUNDSPRITE_NORMAL; }
    building { sprite: ss_hydro_dam(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:32; }
}
spritelayout sl_uranium_mine(tile) {
    ground { sprite: ss_ground(1); }
    building { sprite: ss_uranium_mine(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:36; }
}
spritelayout sl_nuclear_plant(tile) {
    ground { sprite: ss_ground(2); }
    building { sprite: ss_nuclear_plant(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:52; }
}
spritelayout sl_tidal_station(tile) {
    ground { sprite: ss_ground(4); }
    building { sprite: ss_tidal_station(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:13; }
}
spritelayout sl_wind_farm(tile) {
    ground { sprite: (terrain_type == TILETYPE_SNOW || terrain_type == TILETYPE_DESERT) ? GROUNDSPRITE_SNOW : GROUNDSPRITE_NORMAL; }
    building { sprite: ss_wind_farm(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:45; }
}
spritelayout sl_wind_farm_grass {
    ground { sprite: (terrain_type == TILETYPE_SNOW || terrain_type == TILETYPE_DESERT) ? GROUNDSPRITE_SNOW : GROUNDSPRITE_NORMAL; }
}
spritelayout sl_solar_farm(tile) {
    ground { sprite: (terrain_type == TILETYPE_SNOW || terrain_type == TILETYPE_DESERT) ? GROUNDSPRITE_SNOW : GROUNDSPRITE_NORMAL; }
    building { sprite: ss_solar_farm(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:7; }
}
spritelayout sl_substation(tile) {
    ground { sprite: ss_ground(2); }
    building { sprite: ss_substation(tile); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:34; }
}

/* ── INDUSTRY TILES ────────────────────────────────────────────── */
/* One tile type per distinct piece of art, so multi-tile industries read
   as a single structure instead of a repeated icon.
   No tile sets `override`: that would replace a base-game industry tile
   (override:0 is the coal mine's) with our art. */

/* Hydro dam across a river.
   The wall stands on the river tiles, with dry bank at each end: the power
   house on one bank and an abutment on the other. "x" tiles are for a dam
   running along x (the river runs along y); "y" tiles are for a dam running
   along y. "start" and "end" are the bank tiles at the low and high end of
   the dam. The wall tiles carry LSF_ALLOW_ON_WATER, which turns off
   OpenTTD's "no land industry on water" check for them; the bank tiles
   don't, so OpenTTD refuses them on water. When the dam closes, OpenTTD puts
   the river back under the wall tiles. */

/* Flat river water, with river water upstream and downstream of it, so the
   wall crosses the river rather than running along its edge. River class
   only: sea and coast are for the Tidal Station, and canals belong to
   companies. */
switch(FEAT_INDUSTRYTILES, SELF, sw_hydro_crossing_x,
       nearby_tile_slope(0, 0) == SLOPE_FLAT &&
       nearby_tile_class(0, 0)  == TILE_CLASS_WATER && nearby_tile_water_class(0, 0)  == WATER_CLASS_RIVER &&
       nearby_tile_class(0, -1) == TILE_CLASS_WATER && nearby_tile_water_class(0, -1) == WATER_CLASS_RIVER &&
       nearby_tile_class(0, 1)  == TILE_CLASS_WATER && nearby_tile_water_class(0, 1)  == WATER_CLASS_RIVER) { return; }
switch(FEAT_INDUSTRYTILES, SELF, sw_hydro_crossing_y,
       nearby_tile_slope(0, 0) == SLOPE_FLAT &&
       nearby_tile_class(0, 0)  == TILE_CLASS_WATER && nearby_tile_water_class(0, 0)  == WATER_CLASS_RIVER &&
       nearby_tile_class(-1, 0) == TILE_CLASS_WATER && nearby_tile_water_class(-1, 0) == WATER_CLASS_RIVER &&
       nearby_tile_class(1, 0)  == TILE_CLASS_WATER && nearby_tile_water_class(1, 0)  == WATER_CLASS_RIVER) { return; }

/* Minimum water size: the number of river tiles in the 15x15 window centred
   on the dam's spillway tile. A tile can only see -8..+7 tiles away and a
   callback can't loop, so this counts the window one row at a time.
   Water class is 3 for river and 0-2 otherwise, so class / 3 is 1 for a
   river tile and 0 for anything else. It rules out ponds and short stubs;
   it can't measure a whole river. */
switch(FEAT_INDUSTRYTILES, SELF, sw_hydro_river_row_m7,
       nearby_tile_water_class(-7, -7) / 3 + nearby_tile_water_class(-6, -7) / 3 + nearby_tile_water_class(-5, -7) / 3 + nearby_tile_water_class(-4, -7) / 3 + nearby_tile_water_class(-3, -7) / 3 +
       nearby_tile_water_class(-2, -7) / 3 + nearby_tile_water_class(-1, -7) / 3 + nearby_tile_water_class(0, -7) / 3 + nearby_tile_water_class(1, -7) / 3 + nearby_tile_water_class(2, -7) / 3 +
       nearby_tile_water_class(3, -7) / 3 + nearby_tile_water_class(4, -7) / 3 + nearby_tile_water_class(5, -7) / 3 + nearby_tile_water_class(6, -7) / 3 + nearby_tile_water_class(7, -7) / 3) { return; }
switch(FEAT_INDUSTRYTILES, SELF, sw_hydro_river_row_m6,
       nearby_tile_water_class(-7, -6) / 3 + nearby_tile_water_class(-6, -6) / 3 + nearby_tile_water_class(-5, -6) / 3 + nearby_tile_water_class(-4, -6) / 3 + nearby_tile_water_class(-3, -6) / 3 +
       nearby_tile_water_class(-2, -6) / 3 + nearby_tile_water_class(-1, -6) / 3 + nearby_tile_water_class(0, -6) / 3 + nearby_tile_water_class(1, -6) / 3 + nearby_tile_water_class(2, -6) / 3 +
       nearby_tile_water_class(3, -6) / 3 + nearby_tile_water_class(4, -6) / 3 + nearby_tile_water_class(5, -6) / 3 + nearby_tile_water_class(6, -6) / 3 + nearby_tile_water_class(7, -6) / 3) { return; }
switch(FEAT_INDUSTRYTILES, SELF, sw_hydro_river_row_m5,
       nearby_tile_water_class(-7, -5) / 3 + nearby_tile_water_class(-6, -5) / 3 + nearby_tile_water_class(-5, -5) / 3 + nearby_tile_water_class(-4, -5) / 3 + nearby_tile_water_class(-3, -5) / 3 +
       nearby_tile_water_class(-2, -5) / 3 + nearby_tile_water_class(-1, -5) / 3 + nearby_tile_water_class(0, -5) / 3 + nearby_tile_water_class(1, -5) / 3 + nearby_tile_water_class(2, -5) / 3 +
       nearby_tile_water_class(3, -5) / 3 + nearby_tile_water_class(4, -5) / 3 + nearby_tile_water_class(5, -5) / 3 + nearby_tile_water_class(6, -5) / 3 + nearby_tile_water_class(7, -5) / 3) { return; }
switch(FEAT_INDUSTRYTILES, SELF, sw_hydro_river_row_m4,
