/*
 * Energy Transition Industries — OpenTTD NewGRF v11
 * ==================================================
 * Full energy economy with configurable parameters.
 *
 * Cargo chain:
 *   Towns → PASS (workers) → Generators → POWR → Substation → town growth
 *   Uranium Mine → URAN → Nuclear Power Plant → POWR → Substation
 *
 * Coal power stations are overridden to require workers, stop spawning
 * after param_coal_stop_year, and close stochastically after param_coal_close_year.
 */

grf {
    grfid: "RE01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESC);
    version: 11;
    min_compatible_version: 1;

    /* ── ERA DATES ─────────────────────────────────────────────── */
    param {
        param_hydro_year {
            type: int;
            name: string(STR_PARAM_HYDRO_YEAR_NAME);
            desc: string(STR_PARAM_HYDRO_YEAR_DESC);
            min_value: 1930;  max_value: 1960;  def_value: 1950;
        }
    }
    param {
        param_nuclear_year {
            type: int;
            name: string(STR_PARAM_NUCLEAR_YEAR_NAME);
            desc: string(STR_PARAM_NUCLEAR_YEAR_DESC);
            min_value: 1950;  max_value: 1975;  def_value: 1956;
        }
    }
    param {
        param_tidal_year {
            type: int;
            name: string(STR_PARAM_TIDAL_YEAR_NAME);
            desc: string(STR_PARAM_TIDAL_YEAR_DESC);
            min_value: 1960;  max_value: 1985;  def_value: 1966;
        }
    }
    param {
        param_wind_year {
            type: int;
            name: string(STR_PARAM_WIND_YEAR_NAME);
            desc: string(STR_PARAM_WIND_YEAR_DESC);
            min_value: 1970;  max_value: 1995;  def_value: 1980;
        }
    }
    param {
        param_solar_year {
            type: int;
            name: string(STR_PARAM_SOLAR_YEAR_NAME);
            desc: string(STR_PARAM_SOLAR_YEAR_DESC);
            min_value: 1980;  max_value: 2005;  def_value: 1990;
        }
    }
    param {
        param_coal_stop_year {
            type: int;
            name: string(STR_PARAM_COAL_STOP_NAME);
            desc: string(STR_PARAM_COAL_STOP_DESC);
            min_value: 1960;  max_value: 1990;  def_value: 1970;
        }
    }
    param {
        param_coal_close_year {
            type: int;
            name: string(STR_PARAM_COAL_CLOSE_NAME);
            desc: string(STR_PARAM_COAL_CLOSE_DESC);
            min_value: 1980;  max_value: 2020;  def_value: 1990;
        }
    }

    /* ── PLACEMENT ─────────────────────────────────────────────── */
    param {
        param_hydro_water_dist {
            type: int;
            name: string(STR_PARAM_HYDRO_DIST_NAME);
            desc: string(STR_PARAM_HYDRO_DIST_DESC);
            min_value: 2;  max_value: 15;  def_value: 5;
        }
    }
    param {
        param_wind_min_height {
            type: int;
            name: string(STR_PARAM_WIND_HEIGHT_NAME);
            desc: string(STR_PARAM_WIND_HEIGHT_DESC);
            min_value: 0;  max_value: 8;  def_value: 4;
        }
    }
    param {
        param_substation_prob {
            type: int;
            name: string(STR_PARAM_SUBSTATION_PROB_NAME);
            desc: string(STR_PARAM_SUBSTATION_PROB_DESC);
            min_value: 1;  max_value: 10;  def_value: 5;
        }
    }

    /* ── GAMEPLAY ───────────────────────────────────────────────── */
    param {
        param_workers_required {
            type: bool;
            name: string(STR_PARAM_WORKERS_NAME);
            desc: string(STR_PARAM_WORKERS_DESC);
            def_value: 1;
        }
    }

    /* ── SPAWN RATES ───────────────────────────────────────────── */
    param {
        param_prob_hydro {
            type: int;
            name: string(STR_PARAM_PROB_HYDRO_NAME);
            desc: string(STR_PARAM_PROB_HYDRO_DESC);
            min_value: 0;  max_value: 8;  def_value: 1;
        }
    }
    param {
        param_prob_tidal {
            type: int;
            name: string(STR_PARAM_PROB_TIDAL_NAME);
            desc: string(STR_PARAM_PROB_TIDAL_DESC);
            min_value: 0;  max_value: 8;  def_value: 2;
        }
    }
    param {
        param_prob_wind {
            type: int;
            name: string(STR_PARAM_PROB_WIND_NAME);
            desc: string(STR_PARAM_PROB_WIND_DESC);
            min_value: 0;  max_value: 8;  def_value: 3;
        }
    }
    param {
        param_prob_solar {
            type: int;
            name: string(STR_PARAM_PROB_SOLAR_NAME);
            desc: string(STR_PARAM_PROB_SOLAR_DESC);
            min_value: 0;  max_value: 8;  def_value: 2;
        }
    }
    param {
        param_prob_nuclear {
            type: int;
            name: string(STR_PARAM_PROB_NUCLEAR_NAME);
            desc: string(STR_PARAM_PROB_NUCLEAR_DESC);
            min_value: 0;  max_value: 4;  def_value: 1;
        }
    }
    param {
        param_prob_uranium {
            type: int;
            name: string(STR_PARAM_PROB_URANIUM_NAME);
            desc: string(STR_PARAM_PROB_URANIUM_DESC);
            min_value: 0;  max_value: 4;  def_value: 2;
        }
    }

}

/* ── CARGO TABLE ──────────────────────────────────────────────── */
cargotable { POWR, URAN, PASS, COAL, }

/* Cargo item IDs are global cargo slots, not GRF-local IDs. Slots 0-11 hold
 * the default cargos (0 = PASS, 1 = COAL, ...), so using them would replace
 * those cargos. Use slots the default climates leave free. */

/* ── CARGO: POWER ─────────────────────────────────────────────── */
item(FEAT_CARGOS, item_cargo_powr, 32) {
    property {
        cargo_label:           "POWR";
        town_growth_effect:    TOWNGROWTH_GOODS;
        units_of_cargo:        string(STR_CARGO_POWER_UNIT);
        items_of_cargo:        string(STR_CARGO_POWER_ITEM);
        penalty_lowerbound:    0;
        single_penalty_length: 255;
        price_factor:          1000;
        cargo_classes:         bitmask(CC_EXPRESS);
        station_list_colour:   COLOUR_YELLOW;
        weight:                1;
        is_freight:            0;
    }
}

/* ── CARGO: URANIUM ───────────────────────────────────────────── */
item(FEAT_CARGOS, item_cargo_uran, 33) {
    property {
        cargo_label:           "URAN";
        town_growth_effect:    TOWNGROWTH_NONE;
        units_of_cargo:        string(STR_CARGO_URAN_UNIT);
        items_of_cargo:        string(STR_CARGO_URAN_ITEM);
        penalty_lowerbound:    15;
        single_penalty_length: 40;
        price_factor:          3500;
        cargo_classes:         bitmask(CC_BULK);
        station_list_colour:   COLOUR_PALE_GREEN;
        weight:                15;
        is_freight:            1;
    }
}

/* ── SPRITESETS ────────────────────────────────────────────────── */
spriteset(ss_hydro_dam,      "sprites/hydro_dam.png")      { [0,0,64,59, -31,-28] }
spriteset(ss_uranium_mine,   "sprites/uranium_mine.png")   { [0,0,64,55, -31,-24] }
spriteset(ss_nuclear_plant,  "sprites/nuclear_plant.png")  { [0,0,64,61, -31,-30] }
spriteset(ss_tidal_station,  "sprites/tidal_station.png")  { [0,0,64,53, -31,-22] }
spriteset(ss_wind_farm,      "sprites/wind_farm.png")      { [0,0,64,57, -31,-26] }
spriteset(ss_solar_farm,     "sprites/solar_farm.png")     { [0,0,64,51, -31,-20] }
spriteset(ss_substation,     "sprites/substation.png")     { [0,0,64,53, -31,-22] }

spriteset(ss_ground_grass,   "sprites/wind_farm.png")      { [0,26,64,31, -31,0] }
spriteset(ss_ground_dirt,    "sprites/uranium_mine.png")   { [0,24,64,31, -31,0] }
spriteset(ss_ground_stone,   "sprites/nuclear_plant.png")  { [0,30,64,31, -31,0] }
spriteset(ss_ground_water,   "sprites/hydro_dam.png")      { [0,28,64,31, -31,0] }
spriteset(ss_ground_shore,   "sprites/tidal_station.png")  { [0,22,64,31, -31,0] }

/* ── SPRITELAYOUTS ─────────────────────────────────────────────── */
spritelayout sl_hydro_dam {
    ground { sprite: ss_ground_water(0); }
    building { sprite: ss_hydro_dam(0); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:28; }
}
spritelayout sl_uranium_mine {
    ground { sprite: ss_ground_dirt(0); }
    building { sprite: ss_uranium_mine(0); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:24; }
}
spritelayout sl_nuclear_plant {
    ground { sprite: ss_ground_stone(0); }
    building { sprite: ss_nuclear_plant(0); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:30; }
}
spritelayout sl_tidal_station {
    ground { sprite: ss_ground_shore(0); }
    building { sprite: ss_tidal_station(0); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:22; }
}
spritelayout sl_wind_farm {
    ground { sprite: ss_ground_grass(0); }
    building { sprite: ss_wind_farm(0); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:26; }
}
spritelayout sl_solar_farm {
    ground { sprite: ss_ground_dirt(0); }
    building { sprite: ss_solar_farm(0); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:20; }
}
spritelayout sl_substation {
    ground { sprite: ss_ground_stone(0); }
    building { sprite: ss_substation(0); xoffset:0; yoffset:0; zoffset:0; xextent:16; yextent:16; zextent:22; }
}

/* ── INDUSTRY TILES ────────────────────────────────────────────── */
item(FEAT_INDUSTRYTILES, tile_uranium_mine,  0) { property { substitute:0; override:0; land_shape_flags:0; } graphics { default: sl_uranium_mine; } }
item(FEAT_INDUSTRYTILES, tile_nuclear_plant, 1) { property { substitute:0; override:0; land_shape_flags:0; } graphics { default: sl_nuclear_plant; } }
item(FEAT_INDUSTRYTILES, tile_hydro_dam,     2) { property { substitute:0; override:0; land_shape_flags:0; } graphics { default: sl_hydro_dam; } }
item(FEAT_INDUSTRYTILES, tile_tidal_station, 3) { property { substitute:0; override:0; land_shape_flags:0; } graphics { default: sl_tidal_station; } }
item(FEAT_INDUSTRYTILES, tile_wind_farm,     4) { property { substitute:0; override:0; land_shape_flags:0; } graphics { default: sl_wind_farm; } }
item(FEAT_INDUSTRYTILES, tile_solar_farm,    5) { property { substitute:0; override:0; land_shape_flags:0; } graphics { default: sl_solar_farm; } }
item(FEAT_INDUSTRYTILES, tile_substation,    6) { property { substitute:0; override:0; land_shape_flags:0; } graphics { default: sl_substation; } }

/* ── TILE LAYOUTS ──────────────────────────────────────────────── */
tilelayout layout_uranium_mine  { 0,0: tile_uranium_mine;  1,0: tile_uranium_mine;  0,1: tile_uranium_mine;  1,1: tile_uranium_mine; }
tilelayout layout_nuclear_plant { 0,0: tile_nuclear_plant; 1,0: tile_nuclear_plant; 2,0: tile_nuclear_plant;
                                   0,1: tile_nuclear_plant; 1,1: tile_nuclear_plant; 2,1: tile_nuclear_plant;
                                   0,2: tile_nuclear_plant; 1,2: tile_nuclear_plant; 2,2: tile_nuclear_plant; }
tilelayout layout_hydro_dam     { 0,0: tile_hydro_dam;     1,0: tile_hydro_dam;     0,1: tile_hydro_dam;     1,1: tile_hydro_dam; }
tilelayout layout_tidal_station { 0,0: tile_tidal_station; 1,0: tile_tidal_station; }
tilelayout layout_wind_farm     { 0,0: tile_wind_farm;     1,0: tile_wind_farm;     0,1: tile_wind_farm;     1,1: tile_wind_farm; }
tilelayout layout_solar_farm    { 0,0: tile_solar_farm;    1,0: tile_solar_farm;    2,0: tile_solar_farm;
                                   0,1: tile_solar_farm;    1,1: tile_solar_farm;    2,1: tile_solar_farm; }
tilelayout layout_substation    { 0,0: tile_substation;    1,0: tile_substation; }

/* ── PRODUCE BLOCKS ────────────────────────────────────────────── */
produce(prod_uran_6,  0, 0, 0, 6,  0, 0);

produce(prod_powr_12, 0, 0, 0, 12, 0, 0);
produce(prod_powr_10, 0, 0, 0, 10, 0, 0);
produce(prod_powr_8,  0, 0, 0, 8,  0, 0);
produce(prod_powr_6,  0, 0, 0, 6,  0, 0);

/* ═══════════════════════════════════════════════════════════
   LOCATION CHECK CALLBACKS  (use configurable parameters)
   ═══════════════════════════════════════════════════════════ */

/* Hydro: within param_hydro_water_dist tiles of water */
switch(FEAT_INDUSTRIES, SELF, sw_location_hydro,
       water_distance <= param_hydro_water_dist) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Tidal: directly coast-adjacent */
switch(FEAT_INDUSTRIES, SELF, sw_location_tidal, water_distance <= 1) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Wind: above param_wind_min_height */
switch(FEAT_INDUSTRIES, SELF, sw_location_wind,
       nearby_tile_height(0, 0) >= param_wind_min_height) {
    1: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* Solar: flat land only */
switch(FEAT_INDUSTRIES, SELF, sw_location_solar, nearby_tile_slope(0, 0)) {
    0: CB_RESULT_LOCATION_ALLOW;
    CB_RESULT_LOCATION_DISALLOW;
}

/* ═══════════════════════════════════════════════════════════
   CONSTRUCTION PROBABILITY — year-gated via parameters
   ═══════════════════════════════════════════════════════════ */

switch(FEAT_INDUSTRIES, SELF, sw_prob_uranium,  current_year >= 1953)              { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_hydro,    current_year >= param_hydro_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_nuclear,  current_year >= param_nuclear_year){ 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_tidal,    current_year >= param_tidal_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_wind,     current_year >= param_wind_year)   { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }
switch(FEAT_INDUSTRIES, SELF, sw_prob_solar,    current_year >= param_solar_year)  { 1: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY; CB_RESULT_IND_NO_CONSTRUCTION; }

/* ═══════════════════════════════════════════════════════════
   WORKER MECHANIC — monthly production change callbacks
   All generators accept PASS. param_workers_required toggles this.
   ═══════════════════════════════════════════════════════════ */

/* Days since workers last arrived → production change */
switch(FEAT_INDUSTRIES, SELF, sw_workers_days_inner,
       current_date - last_cargo_accepted_at("PASS")) {
    0..60:   CB_RESULT_IND_PROD_INCREMENT_BY_1;
    61..180: CB_RESULT_IND_PROD_NO_CHANGE;
    CB_RESULT_IND_PROD_DECREMENT_BY_1;
}

/* Toggle via parameter */
switch(FEAT_INDUSTRIES, SELF, sw_workers_days, param_workers_required) {
    0: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_workers_days_inner;
}

/* Grace period for newly-built industries */
switch(FEAT_INDUSTRIES, SELF, sw_workers_grace, current_date - build_date) {
    0..90: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_workers_days;
}

/* ═══════════════════════════════════════════════════════════
   COAL POWER STATION OVERRIDE — closure timeline
   ═══════════════════════════════════════════════════════════ */

switch(FEAT_INDUSTRIES, SELF, sw_coal_construction,
       current_year >= param_coal_stop_year) {
    0: CB_RESULT_IND_PROBABILITY_FROM_PROPERTY;
    CB_RESULT_IND_NO_CONSTRUCTION;
}

switch(FEAT_INDUSTRIES, SELF, sw_coal_closure_25pct, random_bits & 3) {
    0:    CB_RESULT_IND_PROD_CLOSE;
    CB_RESULT_IND_PROD_NO_CHANGE;
}
switch(FEAT_INDUSTRIES, SELF, sw_coal_closure_75pct, random_bits & 3) {
    0..2: CB_RESULT_IND_PROD_CLOSE;
    CB_RESULT_IND_PROD_NO_CHANGE;
}
switch(FEAT_INDUSTRIES, SELF, sw_coal_random_prod, current_year >= param_coal_close_year) {
    0: CB_RESULT_IND_PROD_NO_CHANGE;
    return sw_coal_closure_25pct;
}
/* Accelerated closure 20 years after phaseout start */
switch(FEAT_INDUSTRIES, SELF, sw_coal_random_prod_late,
       current_year >= (param_coal_close_year + 20)) {
    1: return sw_coal_closure_75pct;
    return sw_coal_random_prod;
}

/* ═══════════════════════════════════════════════════════════
   INDUSTRIES
   ═══════════════════════════════════════════════════════════ */

/* ── URANIUM MINE ── */
item(FEAT_INDUSTRIES, industry_uranium_mine, 0) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_URANIUM_MINE); nearby_station_name: string(STR_STAT_URANIUM_MINE);
        layouts: [layout_uranium_mine]; life_type: IND_LIFE_TYPE_EXTRACTIVE;
        map_colour: COLOUR_PALE_GREEN; cargo_types: [produce_cargo("URAN", 3)];
        fund_cost_multiplier: 100;
        closure_msg: string(STR_NEWS_URANIUM_CLOSE); prod_increase_msg: string(STR_NEWS_URANIUM_UP);
        prod_decrease_msg: string(STR_NEWS_URANIUM_DOWN); new_ind_msg: string(STR_NEWS_URANIUM_NEW);
        prospect_chance: 0x18000000; prob_in_game: param_prob_uranium; prob_random: param_prob_uranium;
        spec_flags: bitmask(IND_FLAG_ALLOW_CLOSING_LAST_INSTANCE);
    }
    graphics { construction_probability: sw_prob_uranium; produce_256_ticks: prod_uran_6; }
}

/* ── NUCLEAR POWER PLANT ── */
item(FEAT_INDUSTRIES, industry_nuclear_plant, 1) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_NUCLEAR_PLANT); nearby_station_name: string(STR_STAT_NUCLEAR_PLANT);
        layouts: [layout_nuclear_plant]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_RED;
        cargo_types: [accept_cargo("PASS"), accept_cargo("URAN", produce_cargo("POWR", 1)), produce_cargo("POWR", 10)];
        fund_cost_multiplier: 200;
        closure_msg: string(STR_NEWS_NUCLEAR_CLOSE); prod_increase_msg: string(STR_NEWS_NUCLEAR_UP);
        prod_decrease_msg: string(STR_NEWS_NUCLEAR_DOWN); new_ind_msg: string(STR_NEWS_NUCLEAR_NEW);
        prospect_chance: 0x10000000; prob_in_game: param_prob_nuclear; prob_random: param_prob_nuclear; spec_flags: 0;
    }
    graphics {
        construction_probability: sw_prob_nuclear;
        monthly_prod_change: sw_workers_grace;
        /* No produce_256_ticks or produce_cargo_arrival: URAN->POWR conversion
           is handled entirely by cargo_types. Without uranium delivery, zero POWR. */
    }
}

/* ── HYDROELECTRIC DAM ── */
item(FEAT_INDUSTRIES, industry_hydro_dam, 2) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_HYDRO_DAM); nearby_station_name: string(STR_STAT_HYDRO_DAM);
        layouts: [layout_hydro_dam]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_DARK_BLUE;
        cargo_types: [accept_cargo("PASS"), produce_cargo("POWR", 6)];
        fund_cost_multiplier: 80;
        closure_msg: string(STR_NEWS_HYDRO_CLOSE); prod_increase_msg: string(STR_NEWS_HYDRO_UP);
        prod_decrease_msg: string(STR_NEWS_HYDRO_DOWN); new_ind_msg: string(STR_NEWS_HYDRO_NEW);
        prospect_chance: 0x18000000; prob_in_game: param_prob_hydro; prob_random: param_prob_hydro; spec_flags: 0;
    }
    graphics {
        construction_probability: sw_prob_hydro;
        location_check: sw_location_hydro;
        monthly_prod_change: sw_workers_grace;
        produce_256_ticks: prod_powr_12;
    }
}

/* ── TIDAL POWER STATION ── */
item(FEAT_INDUSTRIES, industry_tidal_station, 3) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_TIDAL_STATION); nearby_station_name: string(STR_STAT_TIDAL_STATION);
        layouts: [layout_tidal_station]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_LIGHT_BLUE;
        cargo_types: [accept_cargo("PASS"), produce_cargo("POWR", 5)];
        fund_cost_multiplier: 60;
        closure_msg: string(STR_NEWS_TIDAL_CLOSE); prod_increase_msg: string(STR_NEWS_TIDAL_UP);
        prod_decrease_msg: string(STR_NEWS_TIDAL_DOWN); new_ind_msg: string(STR_NEWS_TIDAL_NEW);
        prospect_chance: 0x20000000; prob_in_game: param_prob_tidal; prob_random: param_prob_tidal;
        spec_flags: bitmask(IND_FLAG_BUILT_ONLY_AFTER_1960);
    }
    graphics {
        construction_probability: sw_prob_tidal;
        location_check: sw_location_tidal;
        monthly_prod_change: sw_workers_grace;
        produce_256_ticks: prod_powr_10;
    }
}

/* ── WIND FARM ── */
item(FEAT_INDUSTRIES, industry_wind_farm, 4) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_WIND_FARM); nearby_station_name: string(STR_STAT_WIND_FARM);
        layouts: [layout_wind_farm]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_PALE_GREEN;
        cargo_types: [accept_cargo("PASS"), produce_cargo("POWR", 4)];
        fund_cost_multiplier: 50;
        closure_msg: string(STR_NEWS_WIND_CLOSE); prod_increase_msg: string(STR_NEWS_WIND_UP);
        prod_decrease_msg: string(STR_NEWS_WIND_DOWN); new_ind_msg: string(STR_NEWS_WIND_NEW);
        prospect_chance: 0x30000000; prob_in_game: param_prob_wind; prob_random: param_prob_wind;
        spec_flags: bitmask(IND_FLAG_BUILT_ONLY_AFTER_1960);
    }
    graphics {
        construction_probability: sw_prob_wind;
        location_check: sw_location_wind;
        monthly_prod_change: sw_workers_grace;
        produce_256_ticks: prod_powr_8;
    }
}

/* ── SOLAR FARM ── */
item(FEAT_INDUSTRIES, industry_solar_farm, 5) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_SOLAR_FARM); nearby_station_name: string(STR_STAT_SOLAR_FARM);
        layouts: [layout_solar_farm]; life_type: IND_LIFE_TYPE_BLACK_HOLE;
        map_colour: COLOUR_YELLOW;
        cargo_types: [accept_cargo("PASS"), produce_cargo("POWR", 3)];
        fund_cost_multiplier: 40;
        closure_msg: string(STR_NEWS_SOLAR_CLOSE); prod_increase_msg: string(STR_NEWS_SOLAR_UP);
        prod_decrease_msg: string(STR_NEWS_SOLAR_DOWN); new_ind_msg: string(STR_NEWS_SOLAR_NEW);
        prospect_chance: 0x28000000; prob_in_game: param_prob_solar; prob_random: param_prob_solar;
        spec_flags: bitmask(IND_FLAG_BUILT_ONLY_AFTER_1960);
    }
    graphics {
        construction_probability: sw_prob_solar;
        location_check: sw_location_solar;
        monthly_prod_change: sw_workers_grace;
        produce_256_ticks: prod_powr_6;
    }
}

/* ── ELECTRICAL SUBSTATION ── */
item(FEAT_INDUSTRIES, industry_substation, 6) {
    property {
        substitute: INDUSTRYTYPE_COAL_MINE;
        name: string(STR_IND_SUBSTATION); nearby_station_name: string(STR_STAT_SUBSTATION);
        layouts: [layout_substation]; life_type: IND_LIFE_TYPE_PROCESSING;
        map_colour: COLOUR_GREY;
        cargo_types: [accept_cargo("POWR")];
        fund_cost_multiplier: 30;
        closure_msg: string(STR_NEWS_SUBSTATION_CLOSE); prod_increase_msg: string(STR_NEWS_SUBSTATION_UP);
        prod_decrease_msg: string(STR_NEWS_SUBSTATION_DOWN); new_ind_msg: string(STR_NEWS_SUBSTATION_NEW);
        prospect_chance: 0x38000000;
        prob_in_game: param_substation_prob;
        prob_random:  param_substation_prob;
        spec_flags: bitmask(IND_FLAG_BUILT_NEAR_TOWN);
    }
}

/* ── COAL POWER STATION OVERRIDE ── */
item(FEAT_INDUSTRIES, ind_coal_power_plant, 7) {
    property {
        substitute:  INDUSTRYTYPE_POWER_PLANT;
        override:    INDUSTRYTYPE_POWER_PLANT;
        name: string(STR_IND_COAL_PLANT); nearby_station_name: string(STR_STAT_COAL_PLANT);
        layouts: [layout_substation];
        life_type: IND_LIFE_TYPE_PROCESSING;
        map_colour: COLOUR_GREY;
        cargo_types: [accept_cargo("COAL"), accept_cargo("PASS")];
        fund_cost_multiplier: 160;
        closure_msg: string(STR_NEWS_COAL_CLOSE); prod_increase_msg: string(STR_NEWS_COAL_UP);
        prod_decrease_msg: string(STR_NEWS_COAL_DOWN); new_ind_msg: string(STR_NEWS_COAL_NEW);
        prospect_chance: 0x00000000; prob_in_game: 2; prob_random: 2;
        spec_flags: bitmask(IND_FLAG_ALLOW_CLOSING_LAST_INSTANCE);
    }
    graphics {
        construction_probability: sw_coal_construction;
        monthly_prod_change:      sw_workers_grace;
        random_prod_change:       sw_coal_random_prod_late;
    }
}
